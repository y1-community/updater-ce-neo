FROM ubuntu:22.04

# The frozen bundle must run on distributions older than the one that built it.
# Ubuntu 22.04 is the oldest base with the Python 3.10 this code needs and a
# glibc (2.35) matched by Ubuntu 22.04+, Debian 12+, Mint 21+, Fedora 36+,
# SteamOS 3 and Raspberry Pi OS 64-bit. Debian Bookworm (glibc 2.36) produced
# binaries that refused to start on Ubuntu 22.04 and older Mint installs.
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libgl1 \
    libegl1 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxcb-image0 \
    libxcb-render-util0 \
    libxcb-util1 \
    libfreetype6 \
    libfontconfig1 \
    libdbus-1-3 \
    libglib2.0-0 \
    libusb-1.0-0 \
    libusb-1.0-0-dev \
    libstdc++6 \
    curl \
    file \
    binutils \
    desktop-file-utils \
    zip \
    ca-certificates \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir pyinstaller -r /tmp/requirements.txt

WORKDIR /workspace

ENTRYPOINT ["/bin/bash"]
