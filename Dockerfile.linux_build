FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libusb-1.0-0 \
    libusb-1.0-0-dev \
    curl \
    file \
    binutils \
    desktop-file-utils \
    ca-certificates \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir pyinstaller -r /tmp/requirements.txt

WORKDIR /workspace

ENTRYPOINT ["/bin/bash"]
