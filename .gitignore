__pycache__/
*.pyc
.venv/
.venv-build/
dist/
mental_model/
build/
*.spec.bak
.cache/

# Third-party runtime payloads (MediaTek-proprietary).
# tools/ IS tracked (bundled SP Flash Tool v5.1904 payloads for Windows and
# Linux ship with the app; see InnioasisUpdater.spec post-build step).
# /SP_Flash_Tool/ at the repo root is a runtime staging location, not source.
/SP_Flash_Tool/

# macOS build artifacts
*.dmg
*.icns
.DS_Store

# Build brand baked in by scripts/set_build_brand.py (packaging only)
src/_build_brand.py

# Scratch directories
scratch/
tools/mtkclient-*-snapshot/
mental_model/

# debug harness run output
debug/work/
/.tmp-agent
*.log

# Machine-specific SP Flash Tool state (paths, history, UI prefs)
tools/linux/SP_Flash_Tool_v5.1904_Linux/history.ini
tools/linux/SP_Flash_Tool_v5.1904_Linux/option.ini

# Local SP Flash Tool source checkout (large, not referenced by the build)
tools/sp-flash-tool-src/
