/* ============================================
   Innioasis Updater — Lumen / Dark-mode-aware QSS
   ============================================ */

/* Global font */
* {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMainWindow {
    background-color: palette(window);
}

/* ---- Left navigation panel ---- */
#nav_panel {
    background-color: #111827;
    border-right: 1px solid #1f2937;
    border-radius: 12px;
    margin: 12px 0 12px 12px;
    padding: 16px 8px;
}

/* ---- Buttons ---- */

/* Primary — blue */
QPushButton[btnType="primary"] {
    background-color: #3B5BDB;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton[btnType="primary"]:hover {
    background-color: #3451C7;
}

QPushButton[btnType="primary"]:disabled {
    background-color: #B8C4D6;
    color: #8896A8;
}

/* Secondary — light/dark aware */
QPushButton[btnType="secondary"] {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    min-height: 20px;
}

QPushButton[btnType="secondary"]:hover {
    background-color: palette(light);
    border-color: palette(midlight);
}

QPushButton[btnType="secondary"]:disabled {
    background-color: palette(midlight);
    color: palette(shadow);
    border-color: palette(mid);
}

/* Success — green */
QPushButton[btnType="success"] {
    background-color: #2B8A3E;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton[btnType="success"]:hover {
    background-color: #237032;
}

/* Danger — red */
QPushButton[btnType="danger"] {
    background-color: #E03131;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton[btnType="danger"]:hover {
    background-color: #C92A2A;
}

/* ---- Progress bar ---- */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: palette(base);
    text-align: center;
    min-height: 12px;
    max-height: 12px;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

QProgressBar[error="true"]::chunk {
    background-color: #E03131;
}

/* ---- Release notes ---- */
QTextEdit#release_notes {
    background-color: palette(base);
    color: palette(text);
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    border: 1px solid palette(mid);
    border-radius: 8px;
    padding: 12px;
}

/* ---- Log view (always dark, even in light mode — terminal aesthetic) ---- */
QTextEdit#log_view {
    background-color: #1A1A2E;
    color: #A0D911;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    border-radius: 8px;
    padding: 12px;
    border: none;
}

/* ---- Titles ---- */
QLabel#page_title {
    font-size: 22px;
    font-weight: bold;
    color: palette(text);
}

QLabel#section_title {
    font-size: 16px;
    font-weight: bold;
    color: palette(text);
}

QLabel#page_subtitle {
    font-size: 13px;
    color: palette(placeholderText);
}

/* ---- List widget ---- */
QListWidget {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 8px;
    padding: 4px;
    font-size: 13px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QListWidget::item:hover {
    background-color: palette(alt-base, palette(light));
}

/* ---- Combo boxes ---- */
QComboBox {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
}

QComboBox:hover {
    border: 1px solid palette(midlight);
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    selection-background-color: #3B5BDB;
    selection-color: white;
    font-size: 13px;
    outline: 0;
}

/* ---- Tab widget ---- */
QTabWidget::pane {
    border: 1px solid palette(mid);
    border-radius: 6px;
    background-color: palette(base);
}

QTabBar::tab {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: palette(base);
    color: #3B5BDB;
    font-weight: bold;
    border-bottom: 2px solid #3B5BDB;
}

QTabBar::tab:hover:!selected {
    background-color: palette(light);
}

/* ---- Line edit ---- */
QLineEdit {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #3B5BDB;
}

QLineEdit::placeholder {
    color: palette(placeholderText);
}

/* ---- Dialog buttons ---- */
QDialogButtonBox QPushButton {
    background-color: #3B5BDB;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
}

QDialogButtonBox QPushButton:hover {
    background-color: #3451C7;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: palette(base);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: palette(mid);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: palette(midlight);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: palette(base);
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: palette(mid);
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: palette(midlight);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- Tooltip ---- */
QToolTip {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 4px;
}
