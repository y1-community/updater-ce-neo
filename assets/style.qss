/* ============================================
   因尼奥斯升级工具 - 样式表
   PRD 第7页 UI 规范：蓝白主题
   ============================================ */

/* 全局字体 - 只设字体，不设 background/border 避免级联污染 */
* {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMainWindow {
    background-color: #F0F4FA;
}

/* ---- 导航栏（左侧） ---- */
#nav_panel {
    background-color: #FFFFFF;
    border-right: 1px solid #E0E7EF;
    border-radius: 12px;
    margin: 12px 0 12px 12px;
    padding: 16px 8px;
}

#nav_panel QPushButton {
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    background: transparent;
    font-size: 14px;
    color: #4A5568;
}

#nav_panel QPushButton:hover {
    background-color: #F0F4FA;
}

#nav_panel QPushButton:disabled {
    color: #B0B7C3;
    background: transparent;
}

#nav_panel QPushButton[active="true"] {
    background-color: #EBF0FF;
    color: #3B5BDB;
    font-weight: bold;
}

/* ---- 按钮类型 PRD 第7/15页 ---- */

/* 主按钮 - 蓝色实心 */
QPushButton[btnType="primary"] {
    background-color: #3B5BDB;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton[btnType="primary"]:hover {
    background-color: #3451C7;
}

QPushButton[btnType="primary"]:disabled {
    background-color: #B8C4D6;
    color: #8896A8;
}

/* 次按钮 - 白底灰边 */
QPushButton[btnType="secondary"] {
    background-color: #FFFFFF;
    color: #4A5568;
    border: 1px solid #D0D7E2;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    min-height: 20px;
}

QPushButton[btnType="secondary"]:hover {
    background-color: #F5F7FA;
    border-color: #A0AEC0;
}

QPushButton[btnType="secondary"]:disabled {
    background-color: #F0F0F0;
    color: #B0B8C4;
    border-color: #E0E0E0;
}

/* 成功按钮 - 绿色 */
QPushButton[btnType="success"] {
    background-color: #2B8A3E;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton[btnType="success"]:hover {
    background-color: #237032;
}

/* 危险按钮 - 红色 */
QPushButton[btnType="danger"] {
    background-color: #E03131;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton[btnType="danger"]:hover {
    background-color: #C92A2A;
}

/* ---- 进度条 ---- */
QProgressBar {
    border: none;
    border-radius: 6px;
    background-color: #E8ECF2;
    text-align: center;
    min-height: 12px;
    max-height: 12px;
}

QProgressBar::chunk {
    background-color: #2B8A3E;
    border-radius: 6px;
}

QProgressBar[error="true"]::chunk {
    background-color: #E03131;
}

/* ---- 版本更新日志 ---- */
QTextEdit#release_notes {
    background-color: #FFFFFF;
    color: #1A1A2E;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    border: 1px solid #E0E7EF;
    border-radius: 8px;
    padding: 12px;
}

/* ---- 日志区域 ---- */
QTextEdit#log_view {
    background-color: #1A1A2E;
    color: #A0D911;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    border-radius: 8px;
    padding: 12px;
    border: none;
}

/* ---- 标题 ---- */
QLabel#page_title {
    font-size: 22px;
    font-weight: bold;
    color: #1A1A2E;
}

QLabel#section_title {
    font-size: 16px;
    font-weight: bold;
    color: #1A1A2E;
}

QLabel#page_subtitle {
    font-size: 13px;
    color: #868E96;
}

/* ---- 语言选择下拉 ---- */
QComboBox#lang_combo {
    padding: 6px 12px;
    border: 1px solid #D0D7E2;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #1A1A2E;
    font-size: 13px;
}

QComboBox#lang_combo::drop-down {
    border: none;
    width: 20px;
}
